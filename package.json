{
  "name": "tiny-trouble-games",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "wordlists": "pnpm --filter @ttg/wordlists run",
    "content": "tsx tools/content/src/cli.ts",
    "verify": "tsx tools/generator/src/verify.ts",
    "bench": "tsx tools/generator/src/bench.ts",
    "dev": "pnpm --filter @ttg/web dev",
    "build": "pnpm --filter @ttg/web build",
    "test": "vitest run",
    "lint": "oxlint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "fast-check": "^4.10.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
